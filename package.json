{
  "name": "dsh-memory-bank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 的项目级记忆插件：Agent 自主判断该不该记，十道门自审，判不了才交人裁决",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "memory",
    "agent",
    "mrp"
  ],
  "homepage": "https://github.com/morning-start/dsh-memory-bank#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morning-start/dsh-memory-bank.git"
  },
  "bugs": {
    "url": "https://github.com/morning-start/dsh-memory-bank/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.6.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "node scripts/check.mjs",
    "bench": "node bench/assembly.mjs && node bench/capture.mjs && node bench/g1-eval.mjs",
    "acceptance": "node bench/acceptance.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
